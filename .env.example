# =============================================================================
# AutoUnite Admin — ENV EXAMPLE (no real secrets)
# Copy to `.env.local` (or `.env`) and fill. Never commit real values.
# Updated: 2026-08-03
# =============================================================================

# API base (local or deployed)
NEXT_PUBLIC_API_URL=http://localhost:3002

# Must match API INTERNAL_API_KEY (sent as X-API-Key header — not ?apiKey=)
# Required after hardcoded fallbacks were removed from related apps.
NEXT_PUBLIC_API_KEY=replace-with-same-as-api-INTERNAL_API_KEY

# Optional: Admin OS env pill label (Preview / Staging / Production)
# NEXT_PUBLIC_ADMIN_ENV=Preview
# NEXT_PUBLIC_APP_ENV=Preview

# Optional: consumer site for Search QA deep links
# NEXT_PUBLIC_CONSUMER_BASE_URL=http://localhost:3000
